---
interface Props {
    phone: string;
    message?: string;
}

const {
    phone = "8000000000",
    message = "Hola! Me gustaría obtener más información.",
} = Astro.props;

const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    id="whatsapp-button"
    class="fixed bottom-8 right-8 z-50 flex items-center group opacity-0 translate-y-10"
    aria-label="Contactar por WhatsApp"
>
    <!-- Botón con efecto de pulso -->
    <div class="relative">
        <!-- Anillos de pulso -->
        <div
            class="absolute inset-0 rounded-full bg-green-500 animate-ping opacity-20"
        >
        </div>
        <div
            class="absolute inset-0 rounded-full bg-green-500 animate-pulse opacity-40"
        >
        </div>

        <!-- Círculo principal -->
        <div
            class="relative flex items-center justify-center w-16 h-16 bg-[#25D366] rounded-full shadow-[0_8px_30px_rgb(37,211,102,0.4)] group-hover:scale-110 transition-transform duration-300"
        >
            <img
                src="/whatsapp-icon.svg"
                alt="WhatsApp"
                class="w-10 h-10 object-contain"
            />
        </div>
    </div>
</a>

<script>
    import { gsap } from "gsap";

    function initWhatsapp() {
        gsap.to("#whatsapp-button", {
            opacity: 1,
            y: 0,
            duration: 1,
            delay: 1.5,
            ease: "power4.out",
        });
    }

    // Inicializar en carga y tras navegaciones de Astro
    document.addEventListener("astro:page-load", initWhatsapp);
</script>

<style>
    /* El efecto de pulso ping es nativo de Tailwind, 
       pero podrías añadir un glow extra aquí si quisieras */
    #whatsapp-button {
        filter: drop-shadow(0 0 15px rgba(37, 211, 102, 0.2));
    }
</style>
